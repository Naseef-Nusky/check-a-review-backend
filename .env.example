# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL)
# Local example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/check_a_review
# DigitalOcean Managed DB (ssl required):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require
# DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/check_a_review
DATABASE_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SendGrid or Resend)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@checkareview.com
RESEND_API_KEY=your-resend-api-key

# Square (Sandbox) — https://developer.squareup.com/apps
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your_square_sandbox_access_token
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:5001/api/subscriptions/webhook
# Catalog plan IDs are optional once you sync plans from CRM → Billing plans
SQUARE_STARTER_PLAN_ID=
SQUARE_PREMIUM_PLAN_ID=
SQUARE_STARTER_AMOUNT_CENTS=2900
SQUARE_PREMIUM_AMOUNT_CENTS=19900
SQUARE_CURRENCY=USD

# AI Review Moderation (Google Gemini — free tier via https://aistudio.google.com/app/apikey)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-flash-latest
AI_AUTO_PUBLISH_THRESHOLD=85

# Super admin seed (used by db:seed)
ADMIN_EMAIL=superadmin@checkareview.com
ADMIN_PASSWORD=SuperAdmin@123
# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Same Client ID is used in frontend as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
