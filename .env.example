# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL)
# Local example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/check_a_review
# DigitalOcean Managed DB (ssl required):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require
# DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/check_a_review
DATABASE_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SendGrid or Resend)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@checkareview.com
RESEND_API_KEY=your-resend-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly

# AI Review Moderation (OpenAI-compatible)
AI_API_KEY=your-openai-api-key
AI_API_URL=https://api.openai.com/v1
AI_AUTO_PUBLISH_THRESHOLD=85

# Admin seed (used by db:seed)
ADMIN_EMAIL=admin@checkareview.com
ADMIN_PASSWORD=Admin@123
